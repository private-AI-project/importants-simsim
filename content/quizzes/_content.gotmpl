{{/*
  data/quizzes/*.json 하나당 페이지를 만든다.

  퀴즈 페이지 1개  : /quizzes/{slug}/
  결과 페이지 N개  : /quizzes/{slug}/{resultId}/

  결과를 따로 URL로 두는 이유는 공유 때문이다. 카카오톡은 공유된 URL의 OG 태그를 읽는데,
  결과가 쿼리 파라미터면 모든 결과가 같은 미리보기로 뜬다. 결과별 페이지여야 "나는 이 유형"이
  미리보기에 그대로 나오고, 그게 이 사이트의 유일한 유통 수단이다.
*/}}
{{ range $slug, $q := hugo.Data.quizzes }}

  {{ $.AddPage (dict
      "path" $slug
      "title" $q.title
      "description" $q.description
      "kind" "page"
      "weight" (default 100 $q.weight)
      "params" (dict
        "quizSlug" $slug
        "emoji" $q.emoji
        "category" $q.category
        "questionCount" (len $q.questions)
        "estimatedMinutes" (default 2 $q.estimatedMinutes)
        "isResult" false
        "ogImage" (default site.Params.defaultOgImage $q.ogImage)
      )
  ) }}

  {{ range $q.results }}
    {{ $.AddPage (dict
        "path" (printf "%s/%s" $slug .id)
        "title" (printf "%s | %s" .name $q.title)
        "description" .summary
        "kind" "page"
        "layout" "result"
        "sitemap" (dict "disable" true)
        "params" (dict
          "quizSlug" $slug
          "resultId" .id
          "isResult" true
          "noindex" true
          "ogImage" (default (default site.Params.defaultOgImage $q.ogImage) .ogImage)
        )
    ) }}
  {{ end }}

{{ end }}
